# Use the official langflow image as base
FROM langflowai/langflow:1.3.3

# Create directories for file ingestion if needed
USER root
RUN mkdir -p /app/file_injest

# Install additional packages for NLTK and Qdrant integration
RUN pip install --no-cache-dir qdrant-client nltk crewai

# Download NLTK data
RUN python -c "import nltk; nltk.download('punkt'); nltk.download('stopwords'); nltk.download('wordnet')"

# Set environment variable for NLTK data
ENV NLTK_DATA=/root/nltk_data

# Set environment variable for Langflow file size limit (1000MB)
ENV LANGFLOW_MAX_FILE_SIZE_UPLOAD=1000

# Expose the port
EXPOSE 7860

# Command to run the application
CMD ["python", "-m", "langflow", "run", "--host", "0.0.0.0", "--port", "7860"]
