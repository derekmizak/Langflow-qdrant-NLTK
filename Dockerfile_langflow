# Use the official langflow image as base
FROM langflowai/langflow:1.4.1

# Create directories for file ingestion if needed
USER root
RUN mkdir -p /app/file_injest && mkdir -p /app/flow_output && mkdir -p /root/nltk_data

# Install additional packages for NLTK and Qdrant integration
RUN pip install --no-cache-dir qdrant-client nltk crewai

# Download NLTK data directly into the container
RUN python -c "import nltk; nltk.download('punkt', download_dir='/root/nltk_data'); nltk.download('stopwords', download_dir='/root/nltk_data'); nltk.download('wordnet', download_dir='/root/nltk_data'); nltk.download('punkt_tab', download_dir='/root/nltk_data')"

# Set environment variable for NLTK data
ENV NLTK_DATA=/root/nltk_data

# Set environment variable for Langflow file size limit
ENV LANGFLOW_MAX_FILE_SIZE_UPLOAD=1024

# Expose the port
EXPOSE 7860

# Command to run the application
CMD ["python", "-m", "langflow", "run", "--host", "0.0.0.0", "--port", "7860"]
